# ============================================================
# GhorKaj SERVER environment variables
# Copy this file to `.env` and replace every value with your own.
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins (CORS whitelist)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# MongoDB Atlas
# Get it from: https://cloud.mongodb.com  ->  Cluster -> Connect -> Drivers
# Replace <user>, <password>, <cluster> and keep the database name (ghorkaj).
# ------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ghorkaj?retryWrites=true&w=majority

# Optional: some ISPs/routers refuse DNS SRV lookups (error: querySrv ECONNREFUSED)
# which mongodb+srv:// needs. If the DB will not connect, set public DNS servers:
DNS_SERVERS=8.8.8.8,1.1.1.1

# ------------------------------------------------------------
# Firebase Admin SDK (SERVER side)  -- this is DIFFERENT from the client web config.
# Get it from: Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> download the JSON file.
#
# Option A (easiest): save the JSON e.g. as server/serviceAccountKey.json and set:
#   GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# Option B: copy the 3 values from that JSON into the FIREBASE_* vars below.
# FIREBASE_PRIVATE_KEY must keep the literal \n newlines from the JSON.
# (The service-account JSON is git-ignored and must never be committed.)
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------
# Encryption key for NID numbers at rest (AES-256-GCM).
# Must be exactly 32 bytes hex (64 hex characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
NID_ENCRYPTION_KEY=

# Secret for local (non-Firebase) login sessions (used if Firebase Admin is absent).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ------------------------------------------------------------
# Super admin bootstrap. Admins never self-register - the first admin is
# created from these values on startup (only when the DB is connected).
# ------------------------------------------------------------
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# ------------------------------------------------------------
# Cloudinary (profile photos - PUBLIC)  [used from Phase 3]
# Get it from: https://cloudinary.com/console  -> "API Environment variable"
# ------------------------------------------------------------
CLOUDINARY_URL=

# ------------------------------------------------------------
# Payment gateway (SSLCommerz sandbox)  [used from Phase 5]
# Get sandbox creds: https://developer.sslcommerz.com/registration/
# ------------------------------------------------------------
PAYMENT_STORE_ID=
PAYMENT_STORE_PASSWORD=
PAYMENT_SANDBOX=true
